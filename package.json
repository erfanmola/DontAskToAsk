{
	"name": "dontasktoask",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.3",
	"engines": {
		"node": ">=22.12",
		"bun": ">=1.3"
	},
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "bun run typecheck && bun run lint && bun run validate",
		"validate": "bun scripts/validate.ts",
		"artwork": "bun scripts/artwork.ts",
		"build": "bun run check && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && bun scripts/prerender.ts",
		"preview": "vite preview --host 127.0.0.1",
		"test": "bun test"
	},
	"dependencies": {
		"@fontsource-variable/manrope": "5.3.0",
		"@fontsource-variable/noto-sans-arabic": "5.3.0",
		"@fontsource-variable/noto-sans-devanagari": "5.3.0",
		"@fontsource-variable/vazirmatn": "5.3.0",
		"solid-icons": "1.2.0",
		"solid-js": "1.9.17"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "latest",
		"@types/fontkit": "^2.0.9",
		"@types/node": "^22.0.0",
		"fontkit": "^2.0.4",
		"sharp": "0.35.5",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vite-plugin-solid": "2.11.14"
	}
}
